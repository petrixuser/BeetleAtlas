# ============================================================================
#  BeetleAtlas – Umgebungsvariablen (Vorlage)
# ----------------------------------------------------------------------------
#  So nutzt du diese Datei:
#    1. Kopiere sie zu ".env":   cp .env.example .env
#    2. Trage unten deine echten Werte ein (v. a. SMTP_USERNAME/SMTP_PASSWORD).
#    3. Starte den Stack neu – die Startskripte und Docker Compose laden .env
#       automatisch. Werte aus .env haben Vorrang vor den Defaults.
#
#  WICHTIG: Die echte ".env" ist per .gitignore ausgeschlossen und darf NICHT
#  eingecheckt werden – sie enthaelt Geheimnisse (App-Passwort etc.).
# ============================================================================

# --- E-Mail-Verifizierung -------------------------------------------------
# true  = das Backend versendet echte Bestaetigungs-Mails ueber den SMTP-Server
# false = Dev-Modus ohne Mailversand (Konto wird direkt aktiviert)
EMAIL_VERIFICATION_SEND_EMAIL=true

# Basis-URL, auf die der Bestaetigungslink in der Mail zeigt (Frontend).
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080

# --- SMTP-Server (echter Versand ueber Gmail) -----------------------------
# Gmail verlangt ein 16-stelliges "App-Passwort" (2-Faktor muss aktiv sein):
#   Google-Konto -> Sicherheit -> Bestaetigung in zwei Schritten ->
#   App-Passwoerter -> neues erstellen. Die 16 Zeichen OHNE Leerzeichen
#   kommen in SMTP_PASSWORD (NICHT dein normales Gmail-Passwort).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=deine-adresse@gmail.com
SMTP_PASSWORD=dein-16-stelliges-app-passwort
# Absender-Adresse (bei Gmail am besten identisch mit SMTP_USERNAME):
SMTP_FROM_EMAIL=deine-adresse@gmail.com
