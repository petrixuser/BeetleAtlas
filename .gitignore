# Lokale Konfiguration — enthaelt API-Keys, darf nie ins Repository
frontend/config/config.local.js
# Alter Pfad (vor der Frontend-Umstrukturierung) — weiter ignorieren, damit eine
# zurueckgebliebene Datei mit echtem API-Key nicht versehentlich committet wird.
frontend/config.local.js

# Claude Code memory — nur lokal
.claude/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Dependencies
node_modules/

# Python
__pycache__/
*.pyc
.venv/
.venv-wsl/
.wsl-ee-venv/

# Lokale Shell-/CLI-Artefakte
*; done
no-http; done
8000
exit; done

# Build-Output
dist/
build/

# Umgebungsvariablen
.env
.env.*
# Ausnahme: die Vorlage ohne Geheimnisse wird eingecheckt
!.env.example

# GBIF Arbeitsordner lokal halten
GBIFdataandCSVSctipts/

# Lokale Dev-Hilfsskripte (WSL-Setup/Diagnose, enthalten lokale Passwoerter) — nie committen
scripts/*.sh
scripts/*.sql
scripts/serve-frontend.py

# Rohe GBIF-Quelldateien (archiviert als gbif-raw-source.zip via Git LFS)
backend/data/*.txt
